{
  "name": "facebook-marketplace-mcp",
  "version": "1.0.0",
  "description": "MCP server for Facebook Marketplace — direct GraphQL API access",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "facebook-marketplace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx scripts/login.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "capture-queries": "tsx scripts/capture-queries.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "playwright": "^1.56.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
